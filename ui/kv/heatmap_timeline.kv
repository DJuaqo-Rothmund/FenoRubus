# ui/kv/heatmap_timeline.kv · Mapa de calor y línea de tiempo
# (antes en ui/layout.kv; se carga en segundo plano: ui/kvload.py)
#:import theme ui.theme
#:import c ui.theme.c
#:import dp kivy.metrics.dp
#:import NoTransition kivy.uix.screenmanager.NoTransition

<HeatmapScreen>:
    md_bg_color: 0, 0, 0, 0
    MDBoxLayout:
        orientation: "vertical"
        TopBar:
            id: bar
            title: "Mapa de fotos"
            left_action_items: [["arrow-left", lambda x: app.back()]]
        FloatLayout:
            id: stage
            MDBoxLayout:
                adaptive_size: True
                spacing: dp(8)
                pos_hint: {"center_x": .5, "top": .985}
                SegButton:
                    text: "Toda la temporada"
                    selected: root.whole_season
                    size_hint: None, None
                    size: dp(156), dp(38)
                    on_release: root.set_scope(True)
                SegButton:
                    text: "Esta semana"
                    selected: not root.whole_season
                    size_hint: None, None
                    size: dp(118), dp(38)
                    on_release: root.set_scope(False)
            MDBoxLayout:
                orientation: "vertical"
                adaptive_size: True
                spacing: dp(8)
                pos_hint: {"right": .97, "center_y": .55}
                MapRound:
                    icon: "plus"
                    on_release: root.zoom(1)
                MapRound:
                    icon: "minus"
                    on_release: root.zoom(-1)
                MapRound:
                    id: layer_btn
                    icon: "map-outline"
                    on_release: root.toggle_layer()
            PaperCard:
                size_hint_x: .94
                pos_hint: {"center_x": .5, "y": .02}
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(8)
                    MDIcon:
                        icon: "fire"
                        theme_text_color: "Custom"
                        text_color: c(theme.BERRY)
                        size_hint: None, None
                        size: dp(24), dp(24)
                        pos_hint: {"center_y": .5}
                    MDLabel:
                        text: root.info
                        font_style: "Caption"
                        adaptive_height: True
                        pos_hint: {"center_y": .5}
                        theme_text_color: "Custom"
                        text_color: c(theme.LEAF_DARK)
                HeatLegend:
                    size_hint_y: None
                    height: dp(10)
                MDBoxLayout:
                    adaptive_height: True
                    Muted:
                        text: "Pocas fotos"
                    Muted:
                        text: "Muchas"
                        halign: "right"
                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(6)
                    opacity: 1 if root.has_pick else 0
                    disabled: not root.has_pick
                    height: self.minimum_height if root.has_pick else 0
                    size_hint_y: None
                    MDLabel:
                        text: root.pick_title
                        bold: True
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: c(theme.LEAF_DARK)
                    MDLabel:
                        text: root.pick_detail
                        font_style: "Caption"
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: c(theme.MUTED)
                    PrimaryButton:
                        text: "Abrir registro"
                        on_release: root.open_pick()

<MapRound@ButtonBehavior+MDIcon>:
    size_hint: None, None
    size: dp(44), dp(44)
    halign: "center"
    theme_text_color: "Custom"
    text_color: c(theme.LEAF_DARK)
    canvas.before:
        Color:
            rgba: c(theme.SURFACE, .88)
        Ellipse:
            pos: self.pos
            size: self.size

<HeatLegend@Widget>:
    canvas:
        Color:
            rgba: c("#6FA86A")
        RoundedRectangle:
            pos: self.x, self.y
            size: self.width * .36, self.height
            radius: [dp(5), 0, 0, dp(5)]
        Color:
            rgba: c("#F4B400")
        Rectangle:
            pos: self.x + self.width * .34, self.y
            size: self.width * .34, self.height
        Color:
            rgba: c("#FF7043")
        Rectangle:
            pos: self.x + self.width * .66, self.y
            size: self.width * .2, self.height
        Color:
            rgba: c("#C62828")
        RoundedRectangle:
            pos: self.x + self.width * .84, self.y
            size: self.width * .16, self.height
            radius: [0, dp(5), dp(5), 0]

<TimelineScreen>:
    md_bg_color: 0, 0, 0, 0
    MDBoxLayout:
        orientation: "vertical"
        TopBar:
            id: bar
            title: "Línea de tiempo"
            left_action_items: [["arrow-left", lambda x: app.back()]]
        MDScrollView:
            id: scroll
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(12), dp(10), dp(16), dp(28)
                spacing: dp(10)
                PaperCard:
                    SectionLabel:
                        text: "LÍNEA DE TIEMPO"
                    MDLabel:
                        id: sub
                        font_style: "Subtitle1"
                        bold: True
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: c(theme.LEAF_DARK)
                    Muted:
                        id: stats
                    StageSparkline:
                        id: spark
                        size_hint_y: None
                        height: dp(110)
                    GhostButton:
                        id: report_btn
                        icon: "file-document-outline"
                        text: "Ver informe completo de la variedad"
                        on_release: root.open_report()
                    BoxLayout:
                        id: film_box
                        size_hint_y: None
                        height: dp(118)
                        ScrollView:
                            id: film_scroll
                            do_scroll_y: False
                            bar_width: dp(3)
                            BoxLayout:
                                id: film
                                size_hint_x: None
                                width: self.minimum_width
                                spacing: dp(8)
                                padding: dp(2), dp(4)
                MDBoxLayout:
                    id: entries
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: 0


<FilmFrame>:
    orientation: "vertical"
    size_hint_x: None
    width: dp(84)
    spacing: dp(3)
    canvas.before:
        Color:
            rgba: c(theme.BERRY) if root.selected else (0, 0, 0, 0)
        Line:
            rounded_rectangle: (self.x - dp(2), self.top - dp(88), self.width + dp(4), dp(88), dp(12))
            width: dp(1.8)
    BoxLayout:
        id: pic
        size_hint_y: None
        height: dp(84)
        opacity: 1 if root.state == "normal" else .7
    BoxLayout:
        size_hint_y: None
        height: dp(18)
        spacing: dp(4)
        Widget:
        Widget:
            size_hint: None, None
            size: dp(9), dp(9)
            pos_hint: {"center_y": .5}
            canvas:
                Color:
                    rgba: root.dot
                Ellipse:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: c(theme.LEAF_DARK, .4)
                Line:
                    circle: (self.center_x, self.center_y, self.width / 2)
                    width: dp(.8)
        Label:
            text: root.label
            font_size: "11sp"
            bold: True
            color: c(theme.BERRY) if root.selected else c(theme.LEAF_DARK)
            size_hint_x: None
            width: self.texture_size[0]
        Widget:
