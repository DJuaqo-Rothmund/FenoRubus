# ui/kv/preview.kv · Vista previa (avance, mosaico de variedades, matriz)
# (antes en ui/layout.kv; se carga en segundo plano: ui/kvload.py)
#:import theme ui.theme
#:import c ui.theme.c
#:import dp kivy.metrics.dp
#:import NoTransition kivy.uix.screenmanager.NoTransition

<StatTile@GlassCard>:
    orientation: "vertical"
    padding: dp(12), dp(10)
    radius: [dp(18)]
    md_bg_color: c(theme.SURFACE, .6)
    size_hint_y: None
    height: dp(78)
    value: ""
    label: ""
    accent: c(theme.LEAF_DARK)
    MDLabel:
        text: root.value
        font_style: "H5"
        bold: True
        theme_text_color: "Custom"
        text_color: root.accent
    MDLabel:
        text: root.label
        font_style: "Caption"
        theme_text_color: "Custom"
        text_color: c(theme.MUTED)
        size_hint_y: None
        height: dp(18)

<ProgressRing>:
    canvas:
        Color:
            rgba: self.track
        Line:
            circle: (self.center_x, self.center_y, min(self.width, self.height) / 2 - self.thickness / 2)
            width: self.thickness / 2
        Color:
            rgba: self.color
        Line:
            circle: (self.center_x, self.center_y, min(self.width, self.height) / 2 - self.thickness / 2, 0, max(0.1, 360 * self.value))
            width: self.thickness / 2
            cap: "round"

<MetricTile@GlassCard>:
    orientation: "vertical"
    padding: dp(6), dp(8)
    radius: [dp(16)]
    md_bg_color: c(theme.SURFACE, .6)
    icon: "circle"
    caption: ""
    text: "—"
    MDIcon:
        icon: root.icon
        font_size: "20sp"
        size_hint: None, None
        size: dp(24), dp(24)
        pos_hint: {"center_x": .5}
        theme_text_color: "Custom"
        text_color: c(theme.LEAF)
    MDLabel:
        text: root.text
        halign: "center"
        font_style: "Subtitle1"
        bold: True
        theme_text_color: "Custom"
        text_color: c(theme.LEAF_DARK)
    MDLabel:
        text: root.caption
        halign: "center"
        font_style: "Caption"
        theme_text_color: "Custom"
        text_color: c(theme.MUTED)

<PreviewTile>:
    orientation: "vertical"
    size_hint_y: None
    height: dp(150)
    spacing: dp(2)
    padding: dp(2), dp(2), dp(2), dp(4)
    FloatLayout:
        size_hint_y: None
        height: dp(104)
        Image:
            id: art
            source: root.berry
            fit_mode: "contain"
            size_hint: (.86, .96) if root.state == "normal" else (.78, .88)
            pos_hint: {"center_x": .5, "center_y": .5}
        BoxLayout:
            size_hint: None, None
            size: badge_lbl.texture_size[0] + dp(12), dp(20)
            pos_hint: {"center_x": .5, "y": 0}
            opacity: 1 if root.badge else 0
            canvas.before:
                Color:
                    rgba: root.badge_bg
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(10)]
                Color:
                    rgba: c(theme.LEAF_DARK, .18)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, dp(10))
                    width: dp(.8)
            Label:
                id: badge_lbl
                text: root.badge
                font_size: "10sp"
                bold: True
                color: root.badge_fg
    MDLabel:
        text: root.title
        font_style: "Caption"
        bold: True
        halign: "center"
        shorten: True
        shorten_from: "right"
        size_hint_y: None
        height: dp(16)
        theme_text_color: "Custom"
        text_color: c(theme.INK)
    MDLabel:
        text: root.subtitle
        font_size: "10sp"
        halign: "center"
        shorten: True
        shorten_from: "right"
        size_hint_y: None
        height: dp(14)
        theme_text_color: "Custom"
        text_color: root.sub_color

<StageChip>:
    size_hint: None, None
    size: chip_lbl.texture_size[0] + dp(16), dp(22)
    canvas.before:
        Color:
            rgba: root.bg
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(11)]
        Color:
            rgba: c(theme.LEAF_DARK, .15)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(11))
            width: dp(.8)
    Label:
        id: chip_lbl
        text: root.text
        font_size: "10sp"
        bold: True
        color: root.fg

<PreviewTab>:
    md_bg_color: 0, 0, 0, 0
    MDScrollView:
        do_scroll_x: False
        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            padding: dp(16), dp(10), dp(16), dp(24)
            spacing: dp(12)
            PaperCard:
                MDBoxLayout:
                    adaptive_height: True
                    SectionLabel:
                        text: "VISTA"
                        pos_hint: {"center_y": .5}
                    SeasonChip:
                        id: season_chip
                        pos_hint: {"center_y": .5}
                        on_release: root.pick_season()
                    Widget:
                        size_hint_y: None
                        height: dp(1)
                    MapRound:
                        icon: "map-marker-radius-outline"
                        font_size: dp(22)
                        size: dp(38), dp(38)
                        text_color: c(theme.BERRY)
                        pos_hint: {"center_y": .5}
                        on_release: app.open_heatmap()
                MDGridLayout:
                    cols: 2
                    spacing: dp(8)
                    adaptive_height: True
                    SegButton:
                        text: root.variety_label
                        selected: root.kind == "variety"
                        on_release: root.set_kind("variety")
                    SegButton:
                        text: "Matriz global"
                        selected: root.kind == "matrix"
                        on_release: root.set_kind("matrix")
                MDBoxLayout:
                    id: params
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(8)
            PaperCard:
                SectionLabel:
                    text: "QUÉ SE MOSTRARÁ"
                MDLabel:
                    id: sum_title
                    font_style: "Subtitle1"
                    bold: True
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: c(theme.LEAF_DARK)
                MDBoxLayout:
                    size_hint_y: None
                    height: dp(96)
                    spacing: dp(14)
                    FloatLayout:
                        size_hint_x: None
                        width: dp(92)
                        ProgressRing:
                            id: ring
                            size_hint: None, None
                            size: dp(88), dp(88)
                            pos_hint: {"center_x": .5, "center_y": .5}
                        MDLabel:
                            id: ring_text
                            text: "0%"
                            halign: "center"
                            font_style: "H6"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: c(theme.BERRY)
                            pos_hint: {"center_x": .5, "center_y": .5}
                    MDGridLayout:
                        cols: 3
                        spacing: dp(6)
                        MetricTile:
                            id: metric_photos
                            icon: "camera-outline"
                            caption: "fotos"
                        MetricTile:
                            id: metric_bbch
                            icon: "sprout-outline"
                            caption: "estados"
                        MetricTile:
                            id: metric_notes
                            icon: "note-text-outline"
                            caption: "notas"
                Muted:
                    id: headline
                MDBoxLayout:
                    id: visual
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(10)
                MDBoxLayout:
                    adaptive_height: True
                    MDLabel:
                        id: lack_text
                        font_style: "Body2"
                        bold: True
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: c(theme.BERRY)
                    MDIcon:
                        icon: "email-fast-outline"
                        font_size: "16sp"
                        size_hint: None, None
                        size: dp(20), dp(20)
                        pos_hint: {"center_y": .5}
                        theme_text_color: "Custom"
                        text_color: c(theme.MUTED)
                    Muted:
                        id: size_text
                        size_hint_x: None
                        width: dp(64)
                        pos_hint: {"center_y": .5}
            PrimaryButton:
                id: preview_btn
                text: "Ver vista previa completa"
                on_release: root.open_preview()
            Muted:
                halign: "center"
                text: "Solo en este teléfono · no se envía"
