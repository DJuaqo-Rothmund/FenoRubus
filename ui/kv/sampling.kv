# ui/kv/sampling.kv · Muestreo, ensayos/predios, sectores y lista de variedades
# (antes en ui/layout.kv; se carga en segundo plano: ui/kvload.py)
#:import theme ui.theme
#:import c ui.theme.c
#:import dp kivy.metrics.dp
#:import NoTransition kivy.uix.screenmanager.NoTransition

<SettingsScreen>:
    md_bg_color: 0, 0, 0, 0
    MDBoxLayout:
        orientation: "vertical"
        TopBar:
            title: "Ajustes generales" if root.general_only else "Ajustes"
            left_action_items: [["arrow-left", lambda x: app.back()]]
        MDBoxLayout:
            id: tabs
            size_hint_y: None
            height: dp(52)
            padding: dp(16), dp(6), dp(16), dp(4)
            spacing: dp(8)
            SegButton:
                text: "General"
                selected: pages.current == "general"
                on_release: root.show("general")
            SegButton:
                id: var_seg
                text: "Registros"
                selected: pages.current == "varieties"
                on_release: root.show("varieties")
        ScreenManager:
            id: pages
            transition: NoTransition()
            Screen:
                name: "general"
                SettingsTab:
                    id: settings
            Screen:
                name: "varieties"
                VarietiesTab:
                    id: varieties

<ExtraChip@ButtonBehavior+Label>:
    on: False
    font_size: "12.5sp"
    bold: True
    size_hint: None, None
    size: self.texture_size[0] + dp(22), dp(30)
    pos_hint: {"center_y": .5}
    color: (1, 1, 1, 1) if self.on else c(theme.BERRY)
    canvas.before:
        Color:
            rgba: c(theme.BERRY, .85 if self.state == "down" else 1) if self.on else c(theme.BERRY_SOFT)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]

<SamplingTab>:
    orientation: "vertical"
    md_bg_color: 0, 0, 0, 0
    MDScrollView:
        do_scroll_x: False
        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            padding: dp(16), dp(14), dp(16), dp(24)
            spacing: dp(12)
            PaperCard:
                padding: dp(8), dp(12)
                MDBoxLayout:
                    adaptive_height: True
                    MDIconButton:
                        icon: "chevron-left"
                        pos_hint: {"center_y": .5}
                        on_release: root.shift_week(-1)
                    WeekHeader:
                        # Tocar la semana abre el selector de temporada.
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(2)
                        padding: 0, dp(2), 0, dp(4)
                        pos_hint: {"center_y": .5}
                        on_release: root.pick_season()
                        AnchorLayout:
                            size_hint_y: None
                            height: dp(34)
                            SeasonChip:
                                id: season_chip
                                on_release: root.pick_season()
                        SectionLabel:
                            id: week_kicker
                            halign: "center"
                            text: "SEMANA"
                            text_color: c(theme.BERRY) if root.extra else c(theme.LEAF)
                        # Tocar el título: calendario para ir a la semana de cualquier día.
                        # Mantenerlo 3 s: mover todos los datos de la semana a otra.
                        WeekTitle:
                            id: week_title
                            text: "Semana del 7 de septiembre"
                            halign: "center"
                            font_style: "H6"
                            theme_text_color: "Custom"
                            text_color: c(theme.BERRY_DARK if root.extra else theme.INK, .6 if self.state == "down" else 1)
                            adaptive_height: True
                            on_release: root.pick_week_date()
                            on_long_press: root.move_week_dialog()
                        Muted:
                            id: week_range
                            halign: "center"
                    MDIconButton:
                        icon: "chevron-right"
                        pos_hint: {"center_y": .5}
                        on_release: root.shift_week(1)
                MDBoxLayout:
                    adaptive_height: True
                    padding: dp(12), 0
                    spacing: dp(10)
                    # Barra propia (la de KivyMD, al cambiar de semana, a veces dejaba el relleno
                    # de la semana anterior dibujado encima del título).
                    WeekBar:
                        id: progress
                        value: 0
                        color: c(theme.BERRY) if root.extra else c(theme.LEAF)
                        back_color: c(theme.BERRY_SOFT) if root.extra else c(theme.LEAF_SOFT)
                        size_hint_y: None
                        height: dp(6)
                        pos_hint: {"center_y": .5}
                    Muted:
                        id: progress_text
                        size_hint_x: None
                        width: dp(96)
                        halign: "right"
                MDBoxLayout:
                    adaptive_height: True
                    padding: dp(4), 0, dp(8), 0
                    spacing: dp(2)
                    MDFlatButton:
                        text: "Semana actual"
                        theme_text_color: "Custom"
                        text_color: c(theme.LEAF_DARK)
                        pos_hint: {"center_y": .5}
                        on_release: root.go_current()
                    Widget:
                    # Segundo muestreo de la semana («Semana 44.5»)
                    ExtraChip:
                        text: root.extra_text
                        on: root.extra
                        on_release: root.extra_action()
                    MDCheckbox:
                        id: skip_box
                        size_hint: None, None
                        size: dp(36), dp(36)
                        pos_hint: {"center_y": .5}
                        color_active: c(theme.BERRY)
                        color_inactive: c(theme.MUTED)
                        on_active: root.set_skipped(self.active)
                    MDLabel:
                        text: "No muestreada"
                        font_style: "Caption"
                        adaptive_size: True
                        pos_hint: {"center_y": .5}
                        theme_text_color: "Custom"
                        text_color: c(theme.INK)
            SectionLabel:
                text: "VARIEDADES · toque para registrar"
            MDBoxLayout:
                id: rows
                orientation: "vertical"
                adaptive_height: True
                spacing: dp(8)

<WorkspaceBanner>:
    size_hint_y: None
    height: dp(36)
    padding: dp(16), 0, dp(12), 0
    spacing: dp(8)
    md_bg_color: c(theme.FILL_DARK)
    radius: [0]
    line_color: 0, 0, 0, 0
    MDIcon:
        icon: root.icon
        size_hint: None, None
        size: dp(20), dp(20)
        font_size: "18sp"
        pos_hint: {"center_y": .5}
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
    MDLabel:
        text: root.text
        font_style: "Body2"
        bold: True
        shorten: True
        pos_hint: {"center_y": .5}
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
    # Mediciones de la semana: círculo flotante (tocar el nombre cambia de ensayo o predio)
    MDIconButton:
        icon: "clipboard-plus-outline"
        size_hint: None, None
        size: dp(40), dp(40)
        padding: dp(7)
        icon_size: "22sp"
        pos_hint: {"center_y": .5}
        md_bg_color: 1, 1, 1, 1
        theme_icon_color: "Custom"
        icon_color: c(theme.LEAF_DARK)
        on_release: root.open_measures()

<WorkspacesScreen>:
    md_bg_color: 0, 0, 0, 0
    MDBoxLayout:
        orientation: "vertical"
        TopBar:
            id: bar
            title: ("I+D · Ensayos" if root.profile == "id" else "Predios") if root.menu_mode else "Ensayos y predios"
            left_action_items: [["arrow-left", lambda x: app.back()]]
            right_action_items: [["view-list-outline" if root.view_mode == "grid" else "view-grid-outline", lambda x: root.toggle_view()]]
        MDBoxLayout:
            size_hint_y: None
            height: 0 if root.menu_mode else dp(56)
            opacity: 0 if root.menu_mode else 1
            disabled: root.menu_mode
            padding: dp(16), dp(8), dp(16), dp(4)
            spacing: dp(8)
            # Ocultos (menú de un solo perfil): alto 0 de verdad. Si solo se deshabilitan,
            # siguen recibiendo los toques y tapaban la flecha «volver» de la barra.
            SegButton:
                text: "I+D"
                height: 0 if root.menu_mode else dp(44)
                selected: root.profile == "id"
                on_release: root.set_profile("id")
            SegButton:
                text: "Predio"
                height: 0 if root.menu_mode else dp(44)
                selected: root.profile == "predio"
                on_release: root.set_profile("predio")
        MDScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(16), dp(6), dp(16), dp(104)
                spacing: dp(10)
                Muted:
                    id: hint
                MDGridLayout:
                    id: ws_list
                    cols: 2 if root.view_mode == "grid" else 1
                    adaptive_height: True
                    spacing: dp(10) if root.view_mode == "grid" else dp(8)
                MDFlatButton:
                    id: archived_btn
                    text: "Ver archivados"
                    pos_hint: {"center_x": .5}
                    theme_text_color: "Custom"
                    text_color: c(theme.LEAF_DARK)
                    on_release: root.toggle_archived()
    MDFloatingActionButton:
        id: add_btn
        icon: "plus"
        md_bg_color: c(theme.BERRY)
        icon_color: 1, 1, 1, 1
        elevation: 2
        pos_hint: {"right": .95, "y": .035}
        on_release: root.new_item()

<SeasonChip@ButtonBehavior+BoxLayout>:
    # «Temporada 2026-2027 ⌄»: abre el selector de temporada.
    text: ""
    size_hint: None, None
    height: dp(30)
    width: lbl.texture_size[0] + dp(58)
    padding: dp(10), 0, dp(8), 0
    spacing: dp(4)
    canvas.before:
        Color:
            rgba: c(theme.LEAF_SOFT) if self.state == "normal" else c(theme.LEAF, .3)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]
    MDIcon:
        icon: "calendar-range"
        font_size: "16sp"
        size_hint: None, None
        size: dp(18), dp(18)
        pos_hint: {"center_y": .5}
        theme_text_color: "Custom"
        text_color: c(theme.LEAF_DARK)
    Label:
        id: lbl
        text: root.text
        bold: True
        font_size: "13sp"
        color: c(theme.LEAF_DARK)
        size_hint: None, None
        size: self.texture_size
        pos_hint: {"center_y": .5}
    MDIcon:
        icon: "chevron-down"
        font_size: "18sp"
        size_hint: None, None
        size: dp(18), dp(18)
        pos_hint: {"center_y": .5}
        theme_text_color: "Custom"
        text_color: c(theme.LEAF_DARK)

<WeekBar@Widget>:
    value: 0
    color: [0, 0, 0, 1]
    back_color: [0, 0, 0, .1]
    canvas:
        Color:
            rgba: self.back_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]
        # Sin avance no se dibuja relleno (un rectángulo redondeado de ancho 0 salía lleno).
        Color:
            rgba: self.color if self.value > 0 else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: max(self.height, self.width * min(1, self.value)) if self.value > 0 else 0, self.height
            radius: [self.height / 2]

<WeekHeader@ButtonBehavior+MDBoxLayout>:
    canvas.before:
        Color:
            rgba: c(theme.LEAF, .08) if self.state == "down" else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

<SamplingCTA@ButtonBehavior+BoxLayout>:
    # Botón destacado «Muestreo» (pantalla de sectores del predio, en la barra).
    title: "Muestreo"
    orientation: "horizontal"
    padding: dp(12), 0, dp(14), 0
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: c(theme.BERRY, .22)
        RoundedRectangle:
            pos: self.x, self.y - dp(3)
            size: self.size
            radius: [self.height / 2]
        Color:
            rgba: c(theme.BERRY_DARK if self.state == "down" else theme.BERRY)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]
    MDIcon:
        icon: "calendar-check"
        halign: "center"
        font_size: "20sp"
        size_hint: None, None
        size: dp(24), dp(24)
        pos_hint: {"center_y": .5}
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
    Label:
        text: root.title
        bold: True
        font_size: "14sp"
        color: 1, 1, 1, 1
        size_hint: None, None
        size: self.texture_size
        pos_hint: {"center_y": .5}

<SectorsScreen>:
    md_bg_color: 0, 0, 0, 0
    MDBoxLayout:
        orientation: "vertical"
        TopBar:
            id: bar
            title: "Sectores"
            left_action_items: [["arrow-left", lambda x: app.back()]]
        MDScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(16), dp(2), dp(16), dp(24)
                spacing: dp(10)
                MDBoxLayout:
                    id: map_box
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(10)
                MDBoxLayout:
                    id: rows
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(8)
                PrimaryButton:
                    id: add_btn
                    text: "+ Nuevo sector"
                    on_release: root.add_sector()
                Muted:
                    id: week_note
                    halign: "center"
    # Acceso destacado al muestreo semanal, al lado del nombre del predio.
    SamplingCTA:
        id: cta_bar
        title: "Muestreo"
        size_hint: None, None
        width: self.minimum_width
        height: dp(40)
        x: root.width - self.width - dp(12)
        y: root.height - (bar.height + self.height) / 2     # centrado en la barra
        on_release: app.enter_home()

<SectorRow>:
    orientation: "horizontal"
    padding: dp(12), dp(8), dp(4), dp(8)
    spacing: dp(12)
    radius: [dp(14)]
    elevation: 0
    size_hint_y: None
    height: dp(74)
    md_bg_color: c(theme.GLASS)
    line_color: c(theme.GLASS_EDGE)
    MDLabel:
        text: root.badge
        bold: True
        halign: "center"
        font_style: "Subtitle2"
        size_hint: None, None
        size: dp(52), dp(48)
        pos_hint: {"center_y": .5}
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
        canvas.before:
            Color:
                rgba: c(theme.BERRY)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(12)]
    MDBoxLayout:
        orientation: "vertical"
        adaptive_height: True
        spacing: dp(2)
        pos_hint: {"center_y": .5}
        MDLabel:
            text: root.title
            font_style: "Subtitle1"
            bold: True
            shorten: True
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: c(theme.INK)
        MDLabel:
            text: root.subtitle
            font_style: "Caption"
            shorten: True
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: c(theme.MUTED)
    MDIcon:
        icon: "check-circle" if root.done else "chevron-right"
        size_hint: None, None
        size: dp(28), dp(28)
        pos_hint: {"center_y": .5}
        theme_text_color: "Custom"
        text_color: c(theme.LEAF) if root.done else c(theme.MUTED)
    MDIconButton:
        icon: "pencil-outline"
        pos_hint: {"center_y": .5}
        on_release: root.screen.edit_sector(root.variety_id)
    MDIconButton:
        icon: "trash-can-outline"
        pos_hint: {"center_y": .5}
        theme_icon_color: "Custom"
        icon_color: c(theme.BERRY)
        on_release: root.screen.delete_sector(root.variety_id)

<WorkspaceRow>:
    orientation: "horizontal"
    padding: dp(14), dp(10), dp(4), dp(10)
    spacing: dp(12)
    radius: [dp(14)]
    elevation: 0
    size_hint_y: None
    height: dp(78)
    md_bg_color: c(theme.BERRY_SOFT) if root.current else c(theme.GLASS)
    line_color: c(theme.BERRY) if root.current else c(theme.GLASS_EDGE)
    MDLabel:
        text: root.code
        bold: True
        halign: "center"
        font_style: "Subtitle1"
        size_hint: None, None
        size: dp(48), dp(48)
        pos_hint: {"center_y": .5}
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
        canvas.before:
            Color:
                rgba: c(theme.FILL_DARK) if root.profile == "id" else c(theme.BERRY)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(12)]
    MDBoxLayout:
        orientation: "vertical"
        adaptive_height: True
        spacing: dp(2)
        pos_hint: {"center_y": .5}
        MDLabel:
            text: root.title
            font_style: "Subtitle1"
            bold: True
            shorten: True
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: c(theme.INK)
        MDLabel:
            text: root.subtitle
            font_style: "Caption"
            shorten: True
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: c(theme.MUTED)
    MDIconButton:
        icon: "dots-vertical"
        pos_hint: {"center_y": .5}
        on_release: root.screen.item_menu(root.ws)

<WorkspaceTile>:
    orientation: "vertical"
    padding: dp(10), dp(16), dp(4), dp(10)
    spacing: dp(4)
    radius: [dp(18)]
    elevation: 0
    size_hint_y: None
    height: dp(176)
    md_bg_color: c(theme.BERRY_SOFT) if root.current else c(theme.GLASS)
    line_color: c(theme.BERRY) if root.current else c(theme.GLASS_EDGE)
    FloatLayout:
        size_hint_y: None
        height: dp(72)
        MDLabel:
            text: root.code
            bold: True
            halign: "center"
            font_style: "H6"
            size_hint: None, None
            size: dp(64), dp(64)
            pos_hint: {"center_x": .5, "center_y": .5}
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            canvas.before:
                Color:
                    rgba: c(theme.LEAF_DARK, .16) if root.profile == "id" else c(theme.BERRY, .16)
                Ellipse:
                    pos: self.x - dp(6), self.y - dp(6)
                    size: self.width + dp(12), self.height + dp(12)
                Color:
                    rgba: c(theme.FILL_DARK) if root.profile == "id" else c(theme.BERRY)
                Ellipse:
                    pos: self.pos
                    size: self.size
        MDIconButton:
            icon: "dots-vertical"
            pos_hint: {"right": 1.02, "top": 1.2}
            on_release: root.screen.item_menu(root.ws)
    MDLabel:
        text: root.title
        font_style: "Subtitle2"
        bold: True
        halign: "center"
        max_lines: 2
        size_hint_y: None
        height: dp(40)
        padding: dp(4), 0
        theme_text_color: "Custom"
        text_color: c(theme.INK)
    MDLabel:
        text: root.subtitle
        font_style: "Caption"
        halign: "center"
        valign: "top"
        max_lines: 3
        size_hint_y: None
        height: dp(46)
        padding: dp(4), 0
        theme_text_color: "Custom"
        text_color: c(theme.MUTED)

<VarietyRow>:
    orientation: "horizontal"
    padding: dp(10)
    spacing: dp(12)
    radius: [dp(12)]
    elevation: 0
    size_hint_y: None
    height: max(dp(76), row_text.height + dp(20))   # crece con el texto (sin «…»)
    md_bg_color: c(theme.GLASS)
    line_color: c(theme.GLASS_EDGE)
    ripple_behavior: True
    MDBoxLayout:
        id: thumb_box
        size_hint: None, None
        size: dp(56), dp(56)
        pos_hint: {"center_y": .5}
    MDBoxLayout:
        id: row_text
        orientation: "vertical"
        pos_hint: {"center_y": .5}
        adaptive_height: True
        spacing: dp(2)
        MDLabel:
            # Ensayo de tratamientos: la parcela (T1R1) en letra chica sobre su significado.
            text: root.kicker
            font_size: "11sp"
            bold: True
            theme_text_color: "Custom"
            text_color: c(theme.BERRY)
            size_hint_y: None
            height: self.texture_size[1] if root.kicker else 0
            text_size: self.width, None
            opacity: 1 if root.kicker else 0
        MDLabel:
            text: root.title
            font_style: "Subtitle1"
            bold: True
            theme_text_color: "Custom"
            text_color: c(theme.INK)
            adaptive_height: True
        MDLabel:
            text: root.subtitle
            font_style: "Caption"
            theme_text_color: "Custom"
            text_color: c(theme.INK_2) if root.done else c(theme.MUTED)
            adaptive_height: True
    MDBoxLayout:
        orientation: "vertical"
        adaptive_size: True
        spacing: dp(4)
        pos_hint: {"center_y": .5}
        Tag:
            text: root.photo_tag
            bg: c(theme.LEAF_SOFT) if root.photos >= 1 else c(theme.BERRY_SOFT)
            fg: c(theme.LEAF_DARK)
            pos_hint: {"right": 1}
        Tag:
            text: root.code_tag
            bg: root.code_bg
            fg: root.code_fg
            pos_hint: {"right": 1}

<VarietiesTab>:
    md_bg_color: 0, 0, 0, 0
    MDScrollView:
        do_scroll_x: False
        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            padding: dp(16), dp(14), dp(16), dp(96)
            spacing: dp(8)
            Muted:
                id: season_caption
            MDBoxLayout:
                id: trial_box
                orientation: "vertical"
                adaptive_height: True
            MDBoxLayout:
                id: rows
                orientation: "vertical"
                adaptive_height: True
                spacing: dp(8)
    MDFloatingActionButton:
        icon: "plus"
        elevation: 1
        md_bg_color: c(theme.BERRY)
        pos_hint: {"right": .95, "y": .03}
        on_release: root.add_dialog()

<VarietyCatalogRow>:
    orientation: "horizontal"
    padding: dp(14), dp(10), dp(4), dp(10)
    spacing: dp(6)
    radius: [dp(12)]
    elevation: 0
    size_hint_y: None
    height: max(dp(76), cat_text.height + dp(20))   # crece con el texto (sin «…»)
    md_bg_color: c(theme.GLASS)
    line_color: c(theme.GLASS_EDGE)
    ripple_behavior: True
    MDBoxLayout:
        id: cat_text
        orientation: "vertical"
        adaptive_height: True
        pos_hint: {"center_y": .5}
        spacing: dp(2)
        MDBoxLayout:
            adaptive_height: True
            spacing: dp(8)
            MDLabel:
                text: root.title
                font_style: "Subtitle1"
                bold: True
                adaptive_size: True
                theme_text_color: "Custom"
                text_color: c(theme.INK)
            Tag:
                # Sin código: un espacio (vacía, una etiqueta mide 100 de alto y estira la tarjeta).
                text: root.code or " "
                opacity: 1 if root.code else 0
                bg: c(theme.BERRY_SOFT)
                fg: c(theme.LEAF_DARK)
                pos_hint: {"center_y": .5}
        MDLabel:
            text: root.summary
            font_style: "Caption"
            theme_text_color: "Custom"
            text_color: c(theme.MUTED)
            adaptive_height: True
    MDIconButton:
        icon: "pencil-outline"
        pos_hint: {"center_y": .5}
        theme_icon_color: "Custom"
        icon_color: c(theme.LEAF_DARK)
        on_release: root.tab.open_variety(root.variety_id)
    MDIconButton:
        icon: "delete-outline"
        pos_hint: {"center_y": .5}
        theme_icon_color: "Custom"
        icon_color: c(theme.BERRY)
        on_release: root.tab.delete_dialog(root.variety_id)
