# ui/kv/variety_measures.kv · Ficha de variedad, mediciones y formularios
# (antes en ui/layout.kv; se carga en segundo plano: ui/kvload.py)
#:import theme ui.theme
#:import c ui.theme.c
#:import dp kivy.metrics.dp
#:import NoTransition kivy.uix.screenmanager.NoTransition

# ---------------------------------------------------------------------------
# Ficha de variedad
# ---------------------------------------------------------------------------
<ValueUnitRow@MDBoxLayout>:
    adaptive_height: True
    spacing: dp(8)

<UnitButton>:
    size_hint_x: None
    width: dp(128)
    pos_hint: {"center_y": .5}
    theme_text_color: "Custom"
    text_color: c(theme.LEAF_DARK)
    line_color: c(theme.LINE)

<VarietyScreen>:
    md_bg_color: 0, 0, 0, 0
    MDBoxLayout:
        orientation: "vertical"
        TopBar:
            id: bar
            title: "Variedad"
            left_action_items: [["arrow-left", lambda x: app.back()]]
            right_action_items: [["content-save-outline", lambda x: root.save()]]
        MDScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(16), dp(12), dp(16), dp(32)
                spacing: dp(12)
                PaperCard:
                    SectionLabel:
                        text: "IDENTIFICACIÓN"
                    Field:
                        id: name
                        hint_text: "Nombre de la variedad"
                    Field:
                        id: code
                        hint_text: "Código / abreviatura (nombre de las fotos)"
                        on_text: root.update_photo_hint()
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(8)
                        GhostButton:
                            id: sector_btn
                            icon: "map-marker-radius-outline"
                            text: "Sector: —"
                            on_release: root.pick_sector()
                        GhostButton:
                            id: irrigation_btn
                            icon: "water-pump"
                            text: "Riego: —"
                            on_release: root.pick_irrigation()
                    Muted:
                        id: photo_hint
                    Field:
                        id: notes
                        hint_text: "Notas (origen, manejo, parcela...)"
                        multiline: True
                PaperCard:
                    SectionLabel:
                        id: metrics_title
                        text: "PARÁMETROS BIOMÉTRICOS"
                    ValueUnitRow:
                        Field:
                            id: historical_yield
                            hint_text: "Rendimiento histórico"
                            input_filter: "float"
                        UnitButton:
                            id: historical_yield_unit
                            options: ["kg/planta", "t/ha", "kg/m lineal"]
                    Field:
                        id: historical_note
                        hint_text: "Temporadas de referencia (ej. prom. 2023-2025)"
                    ValueUnitRow:
                        Field:
                            id: projected_yield
                            hint_text: "Proyección temporada actual"
                            input_filter: "float"
                        UnitButton:
                            id: projected_yield_unit
                            options: ["kg/planta", "t/ha", "kg/m lineal"]
                    ValueUnitRow:
                        Field:
                            id: basal_canes
                            hint_text: "Cañas basales"
                            input_filter: "float"
                        UnitButton:
                            id: basal_canes_unit
                            options: ["por planta", "por m lineal"]
                    ValueUnitRow:
                        Field:
                            id: laterals
                            hint_text: "Laterales reproductivos"
                            input_filter: "float"
                        UnitButton:
                            id: laterals_unit
                            options: ["por caña", "por planta", "por m lineal"]
                PaperCard:
                    SectionLabel:
                        text: "CAMPOS PERSONALIZADOS"
                    Muted:
                        text: "Ej.: Diámetro de caña (mm), Grados Brix, Incidencia fitosanitaria (%)."
                    MDBoxLayout:
                        id: custom
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(4)
                    GhostButton:
                        icon: "plus"
                        text: "Agregar campo"
                        on_release: root.custom_dialog()
                PrimaryButton:
                    text: "Guardar ficha"
                    on_release: root.save()
                GhostButton:
                    icon: "file-chart-outline"
                    text: "Generar ficha de la variedad (PDF)"
                    on_release: root.report()

<CustomFieldRow>:
    adaptive_height: True
    spacing: dp(6)
    padding: dp(4), 0
    MDLabel:
        text: root.key
        font_style: "Body2"
        adaptive_height: True
        pos_hint: {"center_y": .5}
        theme_text_color: "Custom"
        text_color: c(theme.INK_2)
    MDLabel:
        text: root.value
        font_style: "Body2"
        bold: True
        halign: "right"
        adaptive_height: True
        pos_hint: {"center_y": .5}
        theme_text_color: "Custom"
        text_color: c(theme.INK)
    MDIconButton:
        icon: "pencil-outline"
        pos_hint: {"center_y": .5}
        on_release: root.screen.custom_dialog(root.field)
    MDIconButton:
        icon: "close"
        pos_hint: {"center_y": .5}
        theme_icon_color: "Custom"
        icon_color: c(theme.BERRY)
        on_release: root.screen.delete_custom(root.field_id)

<MeasureScreen>:
    md_bg_color: 0, 0, 0, 0
    MDBoxLayout:
        orientation: "vertical"
        TopBar:
            id: bar
            title: "Medición"
            left_action_items: [["arrow-left", lambda x: app.back()]]
            right_action_items: [["file-excel-outline", lambda x: root.export()], ["pencil-outline", lambda x: root.edit()], ["content-save-outline", lambda x: root.save()]]
        MDScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(16), dp(12), dp(16), dp(32)
                spacing: dp(12)
                PaperCard:
                    SectionLabel:
                        id: kicker
                    Muted:
                        id: columns_text
                    Body:
                        id: count_text
                    MDBoxLayout:
                        id: entries
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(6)
                    MDBoxLayout:
                        id: actions
                        adaptive_height: True
                        spacing: dp(8)
                GhostButton:
                    icon: "file-excel-outline"
                    text: "Exportar a Excel (toda la temporada)"
                    on_release: root.export()

<EntryRow>:
    adaptive_height: True
    spacing: dp(8)
    padding: dp(2), dp(2)
    MDBoxLayout:
        id: thumb_box
        size_hint: None, None
        size: (dp(64), dp(64)) if root.has_thumb else (0, dp(40))
        opacity: 1 if root.has_thumb else 0
    MDBoxLayout:
        orientation: "vertical"
        adaptive_height: True
        pos_hint: {"center_y": .5}
        MDLabel:
            text: root.title
            font_style: "Body2"
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: c(theme.INK)
        MDLabel:
            text: root.subtitle
            font_style: "Caption"
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: c(theme.MUTED)
    MDIconButton:
        icon: "pencil-outline"
        pos_hint: {"center_y": .5}
        on_release: root.screen.edit_entry(root.item)
    MDIconButton:
        icon: "close"
        pos_hint: {"center_y": .5}
        theme_icon_color: "Custom"
        icon_color: c(theme.BERRY)
        on_release: root.screen.delete_entry(root.item)

<AttachmentRow>:
    adaptive_height: True
    spacing: dp(8)
    padding: dp(2), dp(2)
    MDBoxLayout:
        id: thumb_box
        size_hint: None, None
        size: dp(64), dp(64)
    MDBoxLayout:
        orientation: "vertical"
        adaptive_height: True
        pos_hint: {"center_y": .5}
        MDLabel:
            text: root.caption or "Sin descripción"
            font_style: "Body2"
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: c(theme.INK if root.caption else theme.MUTED)
        MDLabel:
            text: root.date
            font_style: "Caption"
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: c(theme.MUTED)
    MDIconButton:
        icon: "pencil-outline"
        pos_hint: {"center_y": .5}
        on_release: root.screen.caption_dialog(root.item)
    MDIconButton:
        icon: "close"
        pos_hint: {"center_y": .5}
        theme_icon_color: "Custom"
        icon_color: c(theme.BERRY)
        on_release: root.screen.delete_attachment(root.item)

<CaptionForm>:
    orientation: "vertical"
    adaptive_height: True
    spacing: dp(8)
    padding: 0, dp(8), 0, 0
    Field:
        id: caption
        hint_text: "Descripción (opcional)"

<CustomFieldForm>:
    orientation: "vertical"
    adaptive_height: True
    spacing: dp(8)
    padding: 0, dp(8), 0, 0
    Field:
        id: key
        hint_text: "Nombre del parámetro"
    Field:
        id: value
        hint_text: "Valor"
    Field:
        id: unit
        hint_text: "Unidad (opcional)"
    MDBoxLayout:
        id: suggestions
        adaptive_height: True
        spacing: dp(4)

<VarietyForm>:
    orientation: "vertical"
    adaptive_height: True
    spacing: dp(8)
    padding: 0, dp(8), 0, 0
    GhostButton:
        icon: "format-list-bulleted"
        text: "Elegir del catálogo de variedades"
        on_release: root.pick_catalog()
    Field:
        id: name
        hint_text: "Nombre de la variedad"
    Field:
        id: code
        hint_text: "Código (opcional)"
    MDBoxLayout:
        adaptive_height: True
        spacing: dp(8)
        GhostButton:
            id: sector_btn
            icon: "map-marker-radius-outline"
            text: "Sector: —"
            on_release: root.pick_sector()
        GhostButton:
            id: irrigation_btn
            icon: "water-pump"
            text: "Riego: —"
            on_release: root.pick_irrigation()

<PinForm>:
    orientation: "vertical"
    adaptive_height: True
    padding: 0, dp(8), 0, 0
    spacing: dp(6)
    Field:
        id: pin
        hint_text: "PIN numérico"
        password: True
        input_filter: "int"
        max_text_length: 8
    Muted:
        id: msg
