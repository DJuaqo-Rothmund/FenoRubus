# Canal de compilación (lo lee CI en .github/workflows/android.yml).
# Rama claude/lab-1.2: «PhenoRubus Lab» 1.2.x, paquete org.rubus.fenorubuslab. Se instala
# al lado de la estable (PhenoRubus 1.1.x) para probar lo experimental (detector de flores
# y frutos). Comparte Drive con la estable: no cambiar tablas existentes, solo agregar.
SERIES=1.2
PACKAGE=fenorubuslab
TITLE="PhenoRubus Lab"
ICON=assets/icon_lab.png
