# Canal de compilación (lo lee CI en .github/workflows/android.yml).
# Estable (la que usa el equipo): PhenoRubus 1.1.x, paquete org.rubus.fenorubus.
# La rama claude/lab-1.2 cambia estos valores para «PhenoRubus Lab» 1.2.x, que se
# instala al lado de la estable (otro paquete) para probar lo experimental.
SERIES=1.1
PACKAGE=fenorubus
TITLE=PhenoRubus
ICON=assets/icon.png
