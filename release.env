# Canal de compilación (lo lee CI en .github/workflows/android.yml).
# Rama claude/lab-1.2: «AeonCrop» (antes «PhenoRubus Lab») 1.2.x, paquete org.rubus.fenorubuslab. Se instala
# al lado de la estable (PhenoRubus 1.1.x) para probar lo experimental (detector de flores
# y frutos). Comparte Drive con la estable: no cambiar tablas existentes, solo agregar.
SERIES=1.2
PACKAGE=fenorubuslab
TITLE="AeonCrop"
ICON=assets/icon_aeoncrop.png
ICON_FG=assets/icon_aeoncrop_fg.png   # ícono adaptativo: logo grande…
ICON_BG=assets/icon_aeoncrop_bg.png   # …sobre fondo azul estelar (tools/make_aeon_icon.py)
APK_NAME=AeonCrop          # nombre del instalador (.apk) y del archivo para descargar
