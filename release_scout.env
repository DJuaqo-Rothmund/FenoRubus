# Canal de compilación de la app AeonScout sola (lo lee CI en .github/workflows/android.yml,
# segunda variante del trabajo «apk»). Mismo código que AeonCrop (app_flavor.FLAVOR = "scout"):
# abre directo en AeonScout, sin cultivos. Paquete propio: se instala al lado de PhenoRubus
# y de AeonCrop sin tocarlos. Google Drive necesita un ID de cliente Android para
# org.rubus.aeonscout (misma huella SHA-1 que las otras) en el proyecto de Google Cloud.
SERIES=1.0
PACKAGE=aeonscout
TITLE="AeonScout"
ICON=assets/icon_scout.png
ICON_FG=assets/icon_scout_fg.png
ICON_BG=assets/icon_scout_bg.png
PRESPLASH=assets/presplash_scout.png
FLAVOR=scout
APK_NAME=AeonScout
